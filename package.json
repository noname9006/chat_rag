{
  "name": "telegram-chat-rag-analyzer",
  "version": "3.0.0",
  "description": "Exhaustive RAG-based Telegram chat analyzer with LM Studio - English edition",
  "main": "rag.js",
  "type": "commonjs",
  "scripts": {
    "start": "node rag.js --interactive",
    "build-index": "node rag.js --build-only",
    "interactive": "node rag.js --interactive",
    "analysis:exhaustive": "node rag.js --exhaustive",
    "analysis:fast": "node rag.js --fast",
    "rebuild": "node rag.js --rebuild"
  },
  "keywords": [
    "rag",
    "telegram",
    "chat-analysis",
    "lm-studio",
    "nlp",
    "exhaustive-analysis"
  ],
  "author": "lol",
  "license": "MIT",
  "dependencies": {
    "@xenova/transformers": "^2.17.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}